# Conexão MongoDB (local ou Atlas)
MONGODB_URI=mongodb://localhost:27017/locacao_semirreboques

# Porta da API
PORT=4000

# Segredo do JWT (gere um valor aleatório longo)
JWT_SECRET=troque-por-um-segredo-forte

# Duração da sessão do admin (sessão persistente entre visitas)
JWT_EXPIRES_IN=30d

# Origem permitida (frontend)
CORS_ORIGIN=http://localhost:3000

# --- Armazenamento de imagens (S3) ---
# Defina S3_BUCKET para ativar o envio ao S3; sem ele, salva em disco local (dev).
# S3_BUCKET=sp-locacoes-imagens
# AWS_REGION=sa-east-1
# AWS_ACCESS_KEY_ID=AKIA...          # credencial IAM com s3:PutObject no bucket
# AWS_SECRET_ACCESS_KEY=...          # par do ACCESS_KEY_ID
# S3_PUBLIC_URL=https://cdn.splocacoes.com.br   # opcional: CloudFront/domínio próprio
